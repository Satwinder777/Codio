# ====================================================================
# Codio (CodeNest) Environment Variables
# ====================================================================

# 1. Supabase Project Configuration (Get these from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. Server-Only Supabase Secret (NEVER prefix with NEXT_PUBLIC; use only in trusted server actions / route handlers if needed)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
